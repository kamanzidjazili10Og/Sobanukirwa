{
  "expo": {
    "name": "Sobanukirwa",
    "slug": "sobanukirwa",
    "owner": "kamanzidjazili",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0a2f44",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sobanukirwa.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sobanukirwa needs your location for prayer times and Qibla direction",
        "NSMicrophoneUsageDescription": "Sobanukirwa needs microphone for audio playback"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a2f44"
      },
      "package": "com.sobanukirwa.app",
      "versionCode": 2,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "title": "Sobanukirwa - Islamic App",
      "description": "Sobanukirwa Islamic - Learn the truth, knowledge, and beauty of Islam",
      "bundler": "metro"
    },
    "plugins": [
      "expo-av",
      "expo-notifications",
      "expo-asset",
      "expo-font",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sobanukirwa needs your location for prayer times and Qibla direction"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4df7dd74-5392-4a5c-9474-cd89b9474f48"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
